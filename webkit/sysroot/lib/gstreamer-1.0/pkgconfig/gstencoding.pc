prefix=/
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstencoding
Description: gst-plugins-base: gstencoding
Version: 1.22.8
Requires: gstreamer-pbutils-1.0, gstreamer-video-1.0, gstreamer-audio-1.0, gstreamer-tag-1.0, gstreamer-base-1.0 >=  1.22.0, zlib
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstencoding -lm
Cflags: -I${includedir}
