Version: 1.22.8
Requires: gstreamer-1.0 >=  1.22.0, gstreamer-base-1.0 >=  1.22.0, gstreamer-net-1.0 >=  1.22.0, gio-2.0 >=  2.62.0
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstudp
Cflags: -I${includedir}
