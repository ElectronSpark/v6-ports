prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstreplaygain
Description: gst-plugins-good: gstreplaygain
Version: 1.22.8
Requires: gstreamer-1.0 >=  1.22.0, gstreamer-base-1.0 >=  1.22.0, gstreamer-pbutils-1.0 >=  1.22.0, gstreamer-audio-1.0 >=  1.22.0
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstreplaygain -lm
Cflags: -I${includedir}
