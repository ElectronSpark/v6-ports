prefix=/
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstplayback
Description: gst-plugins-base: gstplayback
Version: 1.22.8
Requires: gstreamer-audio-1.0, gstreamer-tag-1.0, gstreamer-video-1.0, gstreamer-pbutils-1.0, gstreamer-base-1.0 >=  1.22.0, zlib
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstplayback -lm
Cflags: -I${includedir}
