Requires: gstreamer-base-1.0 >=  1.22.0, gstreamer-audio-1.0 >=  1.22.0, gstreamer-riff-1.0 >=  1.22.0
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstwavenc
Cflags: -I${includedir}
