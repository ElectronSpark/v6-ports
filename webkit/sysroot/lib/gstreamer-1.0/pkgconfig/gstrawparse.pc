prefix=/
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstrawparse
Description: gst-plugins-base: gstrawparse
Version: 1.22.8
Requires: gstreamer-video-1.0, gstreamer-audio-1.0, gstreamer-tag-1.0, gstreamer-base-1.0 >=  1.22.0, zlib
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstrawparse -lm
Cflags: -I${includedir}
