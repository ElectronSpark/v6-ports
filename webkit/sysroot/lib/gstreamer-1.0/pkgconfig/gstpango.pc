prefix=/
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstpango
Description: gst-plugins-base: gstpango
Version: 1.22.8
Requires: gstreamer-video-1.0, pangocairo >= 1.22.0, gstreamer-base-1.0 >=  1.22.0, gstreamer-1.0 >=  1.22.0
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstpango -lm
Cflags: -I${includedir}
