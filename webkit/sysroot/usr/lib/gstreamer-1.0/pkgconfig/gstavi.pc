prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstavi
Description: gst-plugins-good: gstavi
Version: 1.22.8
Requires: gstreamer-1.0 >=  1.22.0, gstreamer-riff-1.0 >=  1.22.0, gstreamer-audio-1.0 >=  1.22.0, gstreamer-video-1.0 >=  1.22.0, gstreamer-tag-1.0 >=  1.22.0
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstavi
Cflags: -I${includedir}
