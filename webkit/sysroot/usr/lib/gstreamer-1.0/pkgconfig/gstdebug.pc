prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstdebug
Description: gst-plugins-good: gstdebug
Version: 1.22.8
Requires: gstreamer-1.0 >=  1.22.0, gstreamer-base-1.0 >=  1.22.0, gstreamer-video-1.0 >=  1.22.0
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstdebug
Cflags: -I${includedir}
