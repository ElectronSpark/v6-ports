prefix=/
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstcoreelements
Description: gstreamer: gstcoreelements
Version: 1.22.8
Requires: gstreamer-1.0, gstreamer-base-1.0, glib-2.0 >=  2.62.0, gobject-2.0, gmodule-no-export-2.0
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstcoreelements
Cflags: -I${includedir} -DGST_STATIC_COMPILATION
