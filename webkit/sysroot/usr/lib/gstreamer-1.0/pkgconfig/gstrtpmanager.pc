prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstrtpmanager
Description: gst-plugins-good: gstrtpmanager
Version: 1.22.8
Requires: gstreamer-base-1.0 >=  1.22.0, gstreamer-net-1.0 >=  1.22.0, gstreamer-rtp-1.0 >=  1.22.0, gstreamer-audio-1.0 >=  1.22.0, gio-2.0 >=  2.62.0
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstrtpmanager
Cflags: -I${includedir}
