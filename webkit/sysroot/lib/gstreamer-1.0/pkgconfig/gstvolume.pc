prefix=/
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstvolume
Description: gst-plugins-base: gstvolume
Version: 1.22.8
Requires: gstreamer-audio-1.0, gstreamer-tag-1.0, gstreamer-base-1.0 >=  1.22.0, zlib, gstreamer-1.0 >=  1.22.0
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstvolume -lm
Cflags: -I${includedir}
