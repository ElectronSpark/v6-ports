prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstrtp
Description: gst-plugins-good: gstrtp
Version: 1.22.8
Requires: gstreamer-base-1.0 >=  1.22.0, gstreamer-audio-1.0 >=  1.22.0, gstreamer-video-1.0 >=  1.22.0, gstreamer-tag-1.0 >=  1.22.0, gstreamer-rtp-1.0 >=  1.22.0, gstreamer-pbutils-1.0 >=  1.22.0
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstrtp -lm
Cflags: -I${includedir}
